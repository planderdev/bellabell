# Set environment variables in your hosting platform (Vercel project settings, Docker env, PHP-FPM pool),
# or copy this file to .env for local use. .env is never committed.

APP_ENV=production
# Production requires HTTPS. Local development defaults to http://127.0.0.1:8080.
APP_URL=https://your-company-domain.example
# Signs contact-form tokens and hashes IPs. Required in production, at least 32 random characters:
#   openssl rand -hex 32
APP_SECRET=
# Set to 1 only behind a TLS-terminating proxy or on Vercel (X-Forwarded-Proto is trusted).
TRUST_PROXY_HTTPS=0

# Contact form delivery. The form is enabled when at least one of mail or database is configured.
MAIL_TRANSPORT=smtp
MAIL_TO=partner@jejubellabell.com
MAIL_FROM=
MAIL_FROM_NAME=BELLABELL FARM
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional PostgreSQL (e.g. Supabase) for enquiry storage, shared rate limiting and single-use tokens.
# Apply db/schema.sql first. Example: postgresql://user:password@host:5432/postgres?sslmode=require
DATABASE_URL=

# Enquiry desk at /admin (needs DATABASE_URL and APP_SECRET). Generate the hash with:
#   php -r "echo password_hash('your-password', PASSWORD_DEFAULT);"
ADMIN_PASSWORD_HASH=

# File-based rate limit directory used when DATABASE_URL is empty. Keep it outside the web root.
# CONTACT_RATE_DIR=
